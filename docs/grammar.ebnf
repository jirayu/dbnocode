(* Compact DSL, canonical authoring dialect. Whitespace and // comments are ignored. *)
app          = "APP", quoted, "VERSION", quoted ;
datasource   = "DATASOURCE", quoted, "ADAPTER", adapter ;
adapter      = "sqlite" | "postgres" | "firebird" ;
top_level    = app | datasource | fieldset | form | menu | report | subroutine | reset ;
fieldset     = "FIELDSET", name, { section | field }, "END FIELDSET" ;
form         = "FORM", name, ["TITLE", quoted], ["COLS", integer], ["TABBED"],
               { use | section | field | detail | tree_detail | list | computed | udf |
                  highlight | script | workflow | on_save }, "END" ;
use          = "USE", name, {",", name} ;
section      = "SECTION", quoted ;
field        = name, "|", [integer], "|", [flag, {flag}] ;
detail       = "DETAIL", quoted, "AS", name, ["TOTALS"], {column | prefill | coedit}, "END DETAIL" ;
tree_detail  = "TREE_DETAIL", quoted, "AS", name, {column}, "END TREE_DETAIL" ;
column       = name, "|", [integer], "|", [flag, {flag}] ;
list         = "LIST", name, ":", integer, {name, ":", integer} ;
named_lookup_list = name [ ":" name ], {"," name [ ":" name ] } ;
lookup_target = name { "|" name } ;
computed     = "COMPUTED", {name, "=", expression}, "END COMPUTED" ;
udf          = "UDF", quoted ;
highlight    = "HIGHLIGHT", {expression, "|", name}, "END HIGHLIGHT" ;
script       = "SCRIPT", name, {script_line | stock}, "ENDSCRIPT" ;
stock        = "STOCK", stock_operation, ["REVERSE"],
               stock_mapping, {["|"], stock_mapping}, "END STOCK" ;
stock_operation = "RECEIVE" | "ISSUE" | "ALLOCATE" | "TRANSFER" ;
stock_mapping = stock_role, (expression | name) ;
stock_role   = "LINES" | "ITEM" | "QTY" | "UOM" | "PACK_UOM" |
               "PACK_QTY" | "DATE" | "DOC" | "WAREHOUSE" |
               "FROM_WAREHOUSE" | "TO_WAREHOUSE" | "COST" | "LOT" |
               "TYPE" | "TYPE_OUT" | "TYPE_IN" | "DEMAND" | "LOTS" |
               "RESULT" ;
workflow     = "WORKFLOW", "ON", name, {transition | workflow_action | "---"}, "END WORKFLOW" ;
transition   = name, ">", name, ":", name ;
workflow_action = "ACTION", quoted, ":", name ;
on_save      = "ON SAVE", {posting_line}, "END SAVE" ;
prefill      = "PREFILL", name, ["filter:", expression] ;
coedit       = "COEDIT", name ;
flag         = "req" | "num" | "date" | "time" | "timestamp" | "uuid" | "json" | "email" | "phone" |
                "currency" | "percentage" | "color" | "ro" | "upper" | "prefix:", text |
                "span:", integer | "rows:", integer | "default:", text |
                "opts:", csv | "lookup:", lookup_target [ "INCLUDE" csv | "EXCLUDE" csv | "(" named_lookup_list ")" | "CASCADE" field "->" field ] |
                "fill:", text | "copydetail:", name | "filter:", text | "formula:", expression ;
menu         = "MENU", quoted, ["PULLDOWN" | "MAINMENU"], {group | center}, "END" ;
group        = ("GROUP" | "PULLDOWN"), quoted, {menu_item | "---"}, "END" ;
center       = "CENTER", {menu_item | "---"}, "END" ;
menu_item    = quoted, "=>", target, ["HOTKEY", key] ;
target       = name | name, ".list" | name, ".add" | "EXIT" | "RESET" |
               "REPORTS" | "SETTINGS" | "EXCEL.IMPORT" | "SWITCH" |
               "report:", name ;
report       = "REPORT", name, ["TITLE", quoted], {report_line}, "END REPORT" ;
report_line  = "SOURCE", text | "ORDER", text | "WHERE", expression | columns |
               "GROUP", text | "TOTALS", text | crosstab ;
columns      = "COLUMNS", {report_column}, "END COLUMNS" ;
report_column = name, "|", text, "|", integer, ["|", text] ;
crosstab     = "CROSSTAB", {text, ":", text}, "END CROSSTAB" ;
subroutine   = "SUBROUTINE", name, ["(", [name, {",", name}], ")"], {script_line}, "ENDSUBROUTINE" ;
reset        = "RESET", {text}, "END RESET" ;
(* name, quoted, text, csv, expression, script_line, and posting_line use the implementation rules. *)
